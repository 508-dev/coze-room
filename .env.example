# Runtime
ENVIRONMENT=local
LOG_LEVEL=INFO
SESSION_SECRET=

# Host-run service ports. Leave unset locally to use deterministic worktree ports.
API_HOST=127.0.0.1
# API_PORT=8720
# Set to 1 only behind the single trusted proxy; never expose the app port directly.
TRUST_PROXY=0
WEB_HOST=127.0.0.1
# WEB_PORT=8730

# Optional worktree orchestrator reservations. Leave unset for path-hashed ports.
# Use WORKTREE_PORT_BLOCK_START when the orchestrator reserves a small range.
# Use WORKTREE_PRIMARY_PORT when the orchestrator reserves one public port.
# WORKTREE_PRIMARY_PORT_TARGET can be WEB_PORT or API_PORT.
# WORKTREE_PORT_BLOCK_START=
# WORKTREE_PORT_BLOCK_SIZE=10
# WORKTREE_PRIMARY_PORT=
# WORKTREE_PRIMARY_PORT_TARGET=WEB_PORT

# Docker-published infra ports. Leave unset locally to use deterministic worktree ports.
POSTGRES_HOST_BIND=127.0.0.1
# POSTGRES_HOST_PORT=8740

# Database
POSTGRES_DB=dormouse
POSTGRES_USER=dormouse
POSTGRES_PASSWORD=dormouse
DATABASE_URL=postgresql://dormouse:dormouse@127.0.0.1:8740/dormouse

# Media storage (Cloudflare R2).
# R2_PUBLIC_BASE_URL must be the bucket's custom domain. This single-level
# 508.dev subdomain is covered by Cloudflare Universal SSL; r2.dev is not suitable.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=dormouse-media
R2_PUBLIC_BASE_URL=https://dormouse-media.508.dev

# Observability. Env names exist so a destination can be added later; we ship
# no analytics SDK. Usage metrics are derived from our own server logs.
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=dormouse

# Web
# Client API origin for the WebSocket and REST endpoints (see docs/frontend.md
# for the VITE_API_BASE_URL client mapping). Optional: a production build uses
# the page's own origin and dev falls back to http://127.0.0.1:8820, so set this
# only to point at a different origin.
WEB_API_BASE_URL=http://127.0.0.1:8720

# Public versioned art/audio packs (local Vite serves repo-root packs/ here).
VITE_PACK_BASE_URL=/packs

# Public mirrored rendition base. Empty = gentle TV-off state; never source URLs.
# Production: https://dormouse-media.508.dev (the R2 bucket's custom domain).
VITE_MEDIA_BASE_URL=
# Opt-in Vite dev server ONLY. Use an absolute path, not a literal ~.
# DORMOUSE_MEDIA_DIR=/home/you/dormouse-media/renditions
# VITE_MEDIA_BASE_URL=/__media
