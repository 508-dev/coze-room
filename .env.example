# Runtime
ENVIRONMENT=local
LOG_LEVEL=INFO
SESSION_SECRET=

# Host-run service ports. Leave unset locally to use deterministic worktree ports.
API_HOST=127.0.0.1
# API_PORT=8720
WEB_HOST=127.0.0.1
# WEB_PORT=8730

# Optional worktree orchestrator reservations. Leave unset for path-hashed ports.
# Use WORKTREE_PORT_BLOCK_START when the orchestrator reserves a small range.
# Use WORKTREE_PRIMARY_PORT when the orchestrator reserves one public port.
# WORKTREE_PRIMARY_PORT_TARGET can be WEB_PORT or API_PORT.
# WORKTREE_PORT_BLOCK_START=
# WORKTREE_PORT_BLOCK_SIZE=10
# WORKTREE_PRIMARY_PORT=
# WORKTREE_PRIMARY_PORT_TARGET=WEB_PORT

# Docker-published infra ports. Leave unset locally to use deterministic worktree ports.
POSTGRES_HOST_BIND=127.0.0.1
# POSTGRES_HOST_PORT=8740

# Database
POSTGRES_DB=dormouse
POSTGRES_USER=dormouse
POSTGRES_PASSWORD=dormouse
DATABASE_URL=postgresql://dormouse:dormouse@127.0.0.1:8740/dormouse

# Media storage (Cloudflare R2).
# R2_PUBLIC_BASE_URL must be a custom domain. The r2.dev development URL is
# rate-limited and uncached, and the zero-egress economics do not apply to it.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=dormouse-media
R2_PUBLIC_BASE_URL=https://media.dormouse.house

# Observability. Env names exist so a destination can be added later; we ship
# no analytics SDK. Usage metrics are derived from our own server logs.
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=dormouse

# Web
WEB_API_BASE_URL=http://127.0.0.1:8720
