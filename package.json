{
  "name": "dormouse",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.13",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "./scripts/dev.sh",
    "build": "bun run --cwd apps/client build",
    "lint": "biome check .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "./scripts/check-all.sh",
    "ports": "./scripts/worktree-ports.sh env"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.13",
    "@types/bun": "^1.3.4",
    "typescript": "^5.9.3",
    "vitest": "^4.0.14"
  },
  "trustedDependencies": []
}
